<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Thực đơn</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body {
      font-family: 'Segoe UI', sans-serif;
      background: #fff9f0;
      color: #333;
      padding: 30px;
    }
    h1 {
      text-align: center;
      margin-bottom: 40px;
      color: #d35400;
    }
    .menu-container {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      justify-content: center;
    }
    .menu-item {
      background-color: white;
      border-radius: 12px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
      padding: 20px;
      width: 280px;
      transition: transform 0.3s ease;
    }
    .menu-item:hover {
      transform: translateY(-5px);
    }
    .menu-title {
      font-size: 18px;
      font-weight: bold;
      margin-bottom: 8px;
      color: #2c3e50;
    }
    .menu-sub {
      font-size: 14px;
      color: #888;
      margin-bottom: 6px;
    }
    .menu-price {
      font-size: 16px;
      color: #e74c3c;
      font-weight: bold;
    }
  </style>
</head>
<body>
  <h1>Thực đơn nhà hàng 🍣</h1>

  <div class="menu-container">
    <% items.forEach(item => { %>
      <div class="menu-item">
        <div class="menu-title"><%= item.ten_mon_vn %></div>
        <% if (item.ten_mon_jp || item.ten_mon_cn || item.ten_mon_en) { %>
          <div class="menu-sub">
            <%= item.ten_mon_jp ? item.ten_mon_jp + ' · ' : '' %>
            <%= item.ten_mon_cn ? item.ten_mon_cn + ' · ' : '' %>
            <%= item.ten_mon_en || '' %>
          </div>
        <% } %>
        <div class="menu-price"><%= item.gia.toLocaleString('vi-VN') %> VND</div>
      </div>
    <% }); %>
  </div>
</body>
</html>
